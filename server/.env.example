# Set these in Render -> your service -> Environment (the server reads process.env; it does not load .env files).

# Port to listen on. Render sets this automatically; locally it defaults to 3000.
PORT=3000

# "production" on Render: then only CLIENT_ORIGIN may connect (localhost is allowed outside production).
NODE_ENV=production

# Comma-separated list of browser origins allowed to connect (your Netlify site, custom domains). No trailing slashes.
CLIENT_ORIGIN=https://your-site.netlify.app

# Secret for GET /stats?key=... and /spikes?key=... (leave unset to disable those endpoints).
STATS_KEY=change-me-to-a-long-random-string

# Never set this in production: enables test-only debug socket commands.
# CK_DEBUG=1
